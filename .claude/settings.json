{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-sync.sh",
            "timeout": 30,
            "statusMessage": "Bringing in the latest from GitHub"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-sync.sh",
            "timeout": 30,
            "statusMessage": "Bringing in the latest from GitHub"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-autocommit.sh",
            "timeout": 60,
            "statusMessage": "Saving this turn's changes to GitHub"
          }
        ]
      }
    ]
  }
}
