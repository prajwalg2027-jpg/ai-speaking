{
  "name": "ai-english-coach",
  "version": "0.1.0",
  "description": "Voice-first AI English learning app with an adaptive speaking placement test, powered by Sarvam AI.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "migrate": "node server/db/migrate.js",
    "eval": "node scripts/eval-corrections.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "pg": "^8.23.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "https-proxy-agent": "^7.0.6"
  }
}
