<?xml version="1.0" encoding="utf-8"?>
<!-- Launch animation "Sunrise" (about 0.5 s): the orb glides up into place while its glow warms up behind it.
     The splash never waits for it: MainActivity removes it as soon as the app is ready. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon">
    <target android:name="orb">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateY" android:valueFrom="14" android:valueTo="0" android:duration="460" android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.85" android:valueTo="1" android:duration="460" android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.85" android:valueTo="1" android:duration="460" android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="orbBody">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:duration="300" android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="shine">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="0.7" android:duration="300" android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="haloGroup">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.6" android:valueTo="1" android:duration="420" android:startOffset="140" android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.6" android:valueTo="1" android:duration="420" android:startOffset="140" android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="halo">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:duration="420" android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>
</animated-vector>
