<?xml version="1.0" encoding="utf-8"?>
<!-- Launch animation (about 0.6 s): the orb pops in with a small bounce and its glow fades up, then two rings
     ripple out like a sound wave. The splash never waits for it: MainActivity removes it as soon as the app is ready. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon">
    <target android:name="orb">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.35" android:valueTo="1" android:duration="340"
                    android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.35" android:valueTo="1" android:duration="340"
                    android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="halo">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:duration="420"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="ring1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1" android:valueTo="1.45" android:startOffset="220"
                    android:duration="460" android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="1.45" android:startOffset="220"
                    android:duration="460" android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ring1Path">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:valueFrom="0.8" android:valueTo="0" android:startOffset="220"
                android:duration="460" android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="ring2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1" android:valueTo="1.45" android:startOffset="360"
                    android:duration="460" android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="1.45" android:startOffset="360"
                    android:duration="460" android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ring2Path">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:valueFrom="0.8" android:valueTo="0" android:startOffset="360"
                android:duration="460" android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
</animated-vector>
