# Required: get a key at https://dashboard.sarvam.ai. Without it the app explains what's missing.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Realtime speech-to-text (WebSocket, server-side VAD): the app's only speech path.
SARVAM_REALTIME_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_REALTIME_MODEL=saaras:v4
SARVAM_REALTIME_STREAM_TYPE=balanced

# Transcript format: transcribe | codemix | translate | translit | verbatim.
# codemix keeps English words in English and Hindi words in Devanagari (used for scoring).
SARVAM_STT_MODE=codemix
# Model for the mic test page's REST transcription (max 30 s per clip).
SARVAM_STT_MODEL=saaras:v4

# Text-to-speech: Bulbul v4 Flash. Voice IDs are <persona>_<lang>_<style> (v2/v3 names are rejected).
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=ishita_enhi_companion
SARVAM_TTS_SAMPLE_RATE=24000

# LLM. /v1/chat/completions accepts sarvam-105b and sarvam-105b-conversations (sarvam-m / sarvam-30b → 400).
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_LLM_REPLY_MODEL=sarvam-105b-conversations
# low | medium | high | max  ("none" → 400 on Sarvam models; reasoning tokens count against max_tokens)
SARVAM_LLM_REASONING_EFFORT=low
PORT=3000

# Cost counter (₹, excluding GST). Sarvam's prices change: check sarvam.ai/api-pricing and update these.
PRICE_STT_PER_HOUR=30           # speech-to-text, per hour of audio sent
PRICE_TTS_PER_10K_CHARS=20      # Bulbul v4 Flash, per 10,000 characters
PRICE_LLM_INPUT_PER_M=15        # Sarvam-105B, per million input tokens
PRICE_LLM_CACHED_PER_M=5        #   … cached input tokens
PRICE_LLM_OUTPUT_PER_M=60       #   … output tokens (reasoning tokens included)
PRICES_AS_OF=Nov 2026
