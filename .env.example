# Get a key at https://dashboard.sarvam.ai. Leave empty to run in demo mode (browser speech).
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
# Verify these against https://docs.sarvam.ai; bump versions here, not in code.
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_STT_TRANSLATE_MODEL=saaras:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
SARVAM_LLM_MODEL=sarvam-m
PORT=3000
