# Get a key at https://dashboard.sarvam.ai. Leave empty to run in demo mode (browser speech).
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Speech-to-text: Saaras v4 on /speech-to-text. mode: transcribe | codemix | translate | translit | verbatim
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix
# Leave empty for auto-detect, or force e.g. hi-IN / en-IN
SARVAM_STT_LANGUAGE=

# Text-to-speech: Bulbul v4 Flash. Voice IDs are <persona>_<lang>_<use case>; see the Sarvam voices catalog.
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=ishita_enhi_companion
SARVAM_TTS_SAMPLE_RATE=24000

# LLM: sarvam-m is retired. sarvam-30b (64K ctx, fast) or sarvam-105b (128K ctx).
SARVAM_LLM_MODEL=sarvam-30b
# none | low | medium | high | max  (reasoning tokens count against max_tokens)
SARVAM_LLM_REASONING_EFFORT=low
PORT=3000
