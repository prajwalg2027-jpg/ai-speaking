{
  "hosting": {
    "public": "dist",
    "predeploy": [
      "node \"$PROJECT_DIR/build.mjs\""
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/admin",
        "run": {
          "serviceId": "adam",
          "region": "asia-south1"
        }
      },
      {
        "source": "/admin/**",
        "run": {
          "serviceId": "adam",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/admin/**",
        "run": {
          "serviceId": "adam",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/auth/**",
        "run": {
          "serviceId": "adam",
          "region": "asia-south1"
        }
      },
      {
        "source": "/internal/**",
        "run": {
          "serviceId": "adam",
          "region": "asia-south1"
        }
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), geolocation=(), microphone=(), interest-cohort=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
          }
        ]
      },
      {
        "source": "/admin",
        "headers": [
          {
            "key": "Permissions-Policy",
            "value": "camera=(), geolocation=(), microphone=(self), interest-cohort=()"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "Permissions-Policy",
            "value": "camera=(), geolocation=(), microphone=(self), interest-cohort=()"
          }
        ]
      },
      {
        "source": "**/*.@(css|js|svg|png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/app-config.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "/admin",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  }
}
