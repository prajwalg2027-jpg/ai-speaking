{
  "version": "corrections-v1",
  "note": "Correction quality. expect: mistakes that should be corrected (span = the learner's words; fix = what the corrected text must contain, one of). allow: words that may be corrected or not without penalty (ambiguous or minor). Anything else corrected is a false correction. Voice items follow the voice rules: endings, articles and spelling are not corrected (speech-to-text may have caused them).",
  "items": [
    { "id": "tense-1", "group": "tense", "level": 2, "text": "Yesterday I go to the market with my mother.", "expect": [{ "span": "go", "fix": ["went"], "concept": "past_simple" }] },
    { "id": "tense-2", "group": "tense", "level": 2, "text": "Last week we watch a movie in the theatre.", "expect": [{ "span": "watch", "fix": ["watched", "saw"], "concept": "past_simple" }] },
    { "id": "tense-3", "group": "tense", "level": 3, "text": "I am working here since 2019.", "expect": [{ "span": "am working", "fix": ["have been working", "have worked", "'ve been working"], "concept": "present_perfect" }] },
    { "id": "tense-4", "group": "tense", "level": 2, "text": "When I was child, I am living in Nagpur.", "expect": [{ "span": "was child", "fix": ["a child"], "concept": "articles" }, { "span": "am living", "fix": ["lived", "was living", "used to live"], "concept": "past_simple" }] },
    { "id": "tense-5", "group": "tense", "level": 2, "text": "She didn't went to office today.", "expect": [{ "span": "didn't went", "fix": ["didn't go", "did not go"], "concept": "past_simple" }], "allow": ["to office"] },
    { "id": "tense-6", "group": "tense", "level": 3, "text": "I will call you after I will reach home.", "expect": [{ "span": "will reach", "fix": ["reach", "get"], "concept": "future" }] },
    { "id": "tense-7", "group": "tense", "level": 3, "text": "He has finished his work yesterday.", "expect": [{ "span": "has finished", "fix": ["finished"], "concept": "present_perfect" }] },
    { "id": "irregular-1", "group": "irregular", "level": 2, "text": "I buyed a new phone last month.", "expect": [{ "span": "buyed", "fix": ["bought"], "concept": "past_irregular" }] },
    { "id": "irregular-2", "group": "irregular", "level": 1, "text": "We eated biryani at the wedding.", "expect": [{ "span": "eated", "fix": ["ate", "had"], "concept": "past_irregular" }] },
    { "id": "irregular-3", "group": "irregular", "level": 2, "text": "My son has wrote the exam.", "expect": [{ "span": "has wrote", "fix": ["written", "wrote"], "concept": "past_irregular" }], "allow": ["the exam"] },
    { "id": "agreement-1", "group": "agreement", "level": 1, "text": "My father work in a bank.", "expect": [{ "span": "work", "fix": ["works", "worked"], "concept": "third_person_s" }] },
    { "id": "agreement-2", "group": "agreement", "level": 2, "text": "She don't like spicy food.", "expect": [{ "span": "don't", "fix": ["doesn't", "does not"], "concept": "third_person_s" }] },
    { "id": "agreement-3", "group": "agreement", "level": 3, "text": "Everyone in my family are very kind.", "expect": [{ "span": "are", "fix": ["is"], "concept": "subject_verb_agreement" }] },
    { "id": "agreement-4", "group": "agreement", "level": 3, "text": "The list of items are on the table.", "expect": [{ "span": "are", "fix": ["is"], "concept": "subject_verb_agreement" }] },
    { "id": "articles-1", "group": "articles", "level": 2, "text": "I am engineer in a software company.", "expect": [{ "span": "am engineer", "fix": ["an engineer"], "concept": "articles" }] },
    { "id": "articles-2", "group": "articles", "level": 2, "text": "She is a honest person.", "expect": [{ "span": "a honest", "fix": ["an honest"], "concept": "articles" }] },
    { "id": "articles-3", "group": "articles", "level": 2, "text": "I want to become doctor.", "expect": [{ "span": "become doctor", "fix": ["a doctor"], "concept": "articles" }] },
    { "id": "prep-1", "group": "prepositions", "level": 2, "text": "I was born on 1995.", "expect": [{ "span": "on 1995", "fix": ["in 1995"], "concept": "prepositions" }] },
    { "id": "prep-2", "group": "prepositions", "level": 2, "text": "We will meet in Monday.", "expect": [{ "span": "in Monday", "fix": ["on Monday"], "concept": "prepositions" }] },
    { "id": "prep-3", "group": "prepositions", "level": 3, "text": "I am going to discuss about the project with my manager.", "expect": [{ "span": "discuss about", "fix": ["discuss", "talk about"], "concept": "prepositions" }] },
    { "id": "prep-4", "group": "prepositions", "level": 3, "text": "She is married with a doctor.", "expect": [{ "span": "married with", "fix": ["married to"], "concept": "prepositions" }] },
    { "id": "prep-5", "group": "prepositions", "level": 2, "text": "I am waiting you since morning.", "expect": [{ "span": "waiting you", "fix": ["waiting for you"], "concept": "prepositions" }], "allow": ["am waiting", "since morning", "I am waiting you since morning"] },
    { "id": "order-1", "group": "word_order", "level": 2, "text": "Where you are going?", "expect": [{ "span": "you are going", "fix": ["are you going"], "concept": "questions" }] },
    { "id": "order-2", "group": "word_order", "level": 3, "text": "Can you tell me where is the station?", "expect": [{ "span": "where is the station", "fix": ["where the station is"], "concept": "word_order" }] },
    { "id": "order-3", "group": "word_order", "level": 2, "text": "Why you didn't come yesterday?", "expect": [{ "span": "you didn't come", "fix": ["didn't you come", "did you not come"], "concept": "questions" }] },
    { "id": "order-4", "group": "word_order", "level": 2, "text": "What time the shop opens?", "expect": [{ "span": "the shop opens", "fix": ["does the shop open"], "concept": "questions" }] },
    { "id": "order-5", "group": "word_order", "level": 2, "text": "I like very much this song.", "expect": [{ "span": "like very much this song", "fix": ["like this song very much", "really like this song"], "concept": "word_order" }] },
    { "id": "vocab-1", "group": "vocabulary", "level": 2, "text": "I did a mistake in my report.", "expect": [{ "span": "did a mistake", "fix": ["made a mistake"], "concept": "collocation" }] },
    { "id": "vocab-2", "group": "vocabulary", "level": 2, "text": "He is very much intelligent.", "expect": [{ "span": "very much intelligent", "fix": ["very intelligent"], "concept": "word_choice" }] },
    { "id": "vocab-3", "group": "vocabulary", "level": 2, "text": "I am having two brothers.", "expect": [{ "span": "am having", "fix": ["have"], "concept": "present_simple" }] },
    { "id": "vocab-4", "group": "vocabulary", "level": 1, "text": "Open the light please.", "expect": [{ "span": "Open the light", "fix": ["switch on", "turn on"], "concept": "word_choice" }] },
    { "id": "vocab-5", "group": "vocabulary", "level": 2, "text": "I am feeling very boring in this class.", "expect": [{ "span": "boring", "fix": ["bored"], "concept": "word_choice" }] },
    { "id": "vocab-6", "group": "vocabulary", "level": 2, "text": "Kindly borrow me your pen.", "expect": [{ "span": "borrow me", "fix": ["lend me"], "concept": "word_choice" }], "allow": ["Kindly"] },
    { "id": "informal-1", "group": "valid_informal", "level": 3, "text": "Yeah, I'm gonna watch the match tonight.", "expect": [] },
    { "id": "informal-2", "group": "valid_informal", "level": 3, "text": "Gotta go, my bus is here!", "expect": [] },
    { "id": "informal-3", "group": "valid_informal", "level": 2, "text": "Me too! I love dosa.", "expect": [] },
    { "id": "informal-4", "group": "valid_informal", "level": 2, "text": "Not bad, just a bit tired today.", "expect": [] },
    { "id": "informal-5", "group": "valid_informal", "level": 3, "text": "Wanna grab some chai later?", "expect": [] },
    { "id": "informal-6", "group": "valid_informal", "level": 3, "text": "Honestly, I kinda like rainy days.", "expect": [] },
    { "id": "indian-1", "group": "valid_indian", "level": 3, "text": "I'll prepone the meeting to 10 am.", "expect": [] },
    { "id": "indian-2", "group": "valid_indian", "level": 2, "text": "We stay in Andheri, near the station.", "expect": [] },
    { "id": "indian-3", "group": "valid_indian", "level": 2, "text": "My office timings are 9 to 6.", "expect": [] },
    { "id": "indian-4", "group": "valid_indian", "level": 3, "text": "He's out of station this week.", "expect": [] },
    { "id": "indian-5", "group": "valid_indian", "level": 2, "text": "Please give me a missed call when you reach.", "expect": [] },
    { "id": "indian-6", "group": "valid_indian", "level": 2, "text": "My shirt was very costly.", "expect": [] },
    { "id": "valid-1", "group": "valid_standard", "level": 2, "text": "I went to the market yesterday and bought some vegetables.", "expect": [] },
    { "id": "valid-2", "group": "valid_standard", "level": 3, "text": "She has lived in Delhi for ten years.", "expect": [] },
    { "id": "valid-3", "group": "valid_standard", "level": 4, "text": "If I had more time, I would learn to play the guitar.", "expect": [] },
    { "id": "valid-4", "group": "valid_standard", "level": 1, "text": "My brother works in a hospital in Pune.", "expect": [] },
    { "id": "valid-5", "group": "valid_standard", "level": 3, "text": "Could you tell me where the nearest ATM is?", "expect": [] },
    { "id": "valid-6", "group": "valid_standard", "level": 4, "text": "I've never been to Kerala, but I'd love to go.", "expect": [] },
    { "id": "valid-7", "group": "valid_standard", "level": 4, "text": "Although it was raining, we decided to go for a walk.", "expect": [] },
    { "id": "valid-8", "group": "valid_standard", "level": 2, "text": "I'm good, thanks.", "expect": [] },
    { "id": "valid-9", "group": "valid_standard", "level": 4, "text": "None of the students were late.", "expect": [] },
    { "id": "valid-10", "group": "valid_standard", "level": 3, "text": "Who did you meet at the party?", "expect": [] },
    { "id": "valid-11", "group": "valid_standard", "level": 1, "text": "I like cricket. I play on Sundays.", "expect": [] },
    { "id": "ambiguous-1", "group": "ambiguous", "level": 3, "text": "Please do the needful and revert back by today.", "expect": [], "allow": ["revert back", "do the needful", "by today", "revert back by today"] },
    { "id": "ambiguous-2", "group": "ambiguous", "level": 2, "text": "My cousin brother is coming tomorrow.", "expect": [], "allow": ["cousin brother"] },
    { "id": "ambiguous-3", "group": "ambiguous", "level": 2, "text": "She gave an exam yesterday.", "expect": [], "allow": ["gave an exam", "gave"] },
    { "id": "ambiguous-4", "group": "ambiguous", "level": 2, "text": "I am staying here only.", "expect": [], "allow": ["here only", "am staying"] },
    { "id": "ambiguous-5", "group": "ambiguous", "level": 3, "text": "I have done my graduation in commerce.", "expect": [], "allow": ["have done my graduation", "done my graduation", "have done", "my graduation"] },
    { "id": "beginner-1", "group": "beginner", "level": 1, "text": "Me go office morning, come evening.", "expect": [{ "span": "Me go", "fix": ["I go"], "concept": "pronouns" }], "allow": ["office", "go office", "morning", "come evening", "office morning", "Me go office morning", "come evening"] },
    { "id": "beginner-2", "group": "beginner", "level": 1, "text": "I am from Lucknow. I am work in shop.", "expect": [{ "span": "am work", "fix": ["work", "am working"], "concept": "present_simple" }], "allow": ["in shop", "work in shop", "am work in shop"] },
    { "id": "beginner-3", "group": "beginner", "level": 1, "text": "He no like tea.", "expect": [{ "span": "no like", "fix": ["doesn't like", "does not like"], "concept": "negatives" }] },
    { "id": "advanced-1", "group": "advanced", "level": 4, "text": "If I would have known, I would have come earlier.", "expect": [{ "span": "would have known", "fix": ["had known"], "concept": "modal_verbs" }] },
    { "id": "advanced-2", "group": "advanced", "level": 4, "text": "The amount of people at the event was surprising.", "expect": [{ "span": "amount of people", "fix": ["number of people"], "concept": "word_choice" }] },
    { "id": "advanced-3", "group": "advanced", "level": 4, "text": "I look forward to meet you.", "expect": [{ "span": "to meet", "fix": ["to meeting"], "concept": "other" }] },
    { "id": "voice-1", "group": "voice", "channel": "voice", "level": 2, "text": "yesterday i went to market and buy vegetable", "expect": [{ "span": "buy", "fix": ["bought"], "concept": "past_simple" }], "allow": ["and buy vegetable"] },
    { "id": "voice-2", "group": "voice", "channel": "voice", "level": 2, "text": "my sister work in hospital", "expect": [], "note": "-s ending and article: could be speech-to-text" },
    { "id": "voice-3", "group": "voice", "channel": "voice", "level": 2, "text": "i have two brother and one sister", "expect": [], "note": "plural -s: could be speech-to-text" },
    { "id": "voice-4", "group": "voice", "channel": "voice", "level": 2, "text": "he dont know the answer", "expect": [{ "span": "dont", "fix": ["doesn't", "does not"], "concept": "third_person_s" }] },
    { "id": "voice-5", "group": "voice", "channel": "voice", "level": 2, "text": "where you are working these days", "expect": [{ "span": "you are working", "fix": ["are you working"], "concept": "questions" }] },
    { "id": "voice-6", "group": "voice", "channel": "voice", "level": 2, "text": "i watch the movie yesterday", "expect": [], "note": "-ed ending: could be speech-to-text" },
    { "id": "voice-7", "group": "voice", "channel": "voice", "level": 3, "text": "she is more taller than me", "expect": [{ "span": "more taller", "fix": ["taller"], "concept": "comparatives" }] }
  ]
}
